# Copy this file to .env and adjust as needed.
# docker-compose will pick it up automatically.

# Port to expose on the host (default: 8000)
# PORT=8000

# Host path for the database and app state (default: ./data)
# DATA_PATH=/mnt/nas/castcharm/data

# Host path for downloaded audio files (default: ./downloads)
# DOWNLOAD_PATH=/mnt/nas/podcasts

# Advanced: additional IPs allowed to set X-Forwarded-For, comma-separated.
# 127.0.0.1 and ::1 are always trusted, so a same-host reverse proxy needs
# nothing here. Set this only if your proxy runs in a separate container.
# CASTCHARM_TRUSTED_PROXIES=172.18.0.5
